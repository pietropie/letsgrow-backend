# App
APP_NAME="LetsGrow API"
APP_VERSION="0.1.0"
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://letsgrow:letsgrow_dev@localhost:5432/letsgrow

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_FORTE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google AI (Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Provedores alternativos (opcionais) + Painel admin de IA em /admin/ai-panel
# — permite trocar provider/modelo de chat e embedding em runtime, sem
# redeploy. Preencha as chaves dos provedores que for usar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DeepSeek e Z.ai/GLM — só chat (sem embeddings utilizáveis aqui)
DEEPSEEK_API_KEY=
ZAI_API_KEY=
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# MQTT (Eclipse Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MinIO (Storage)
# MINIO_ENDPOINT = host interno usado pelo backend (em produção: nome do
# serviço no docker-compose, ex. "minio:9000" — não alcançável pelo celular).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=letsgrow
MINIO_SECRET_KEY=letsgrow_dev
MINIO_BUCKET=letsgrow-media
MINIO_SECURE=false
# MINIO_PUBLIC_ENDPOINT = host:porta PÚBLICO usado para gerar as URLs de
# upload/download de fotos enviadas ao app mobile (precisa resolver e responder
# pela internet — domínio ou IP:porta do servidor). Sem isso, o app recebe
# URLs com o host interno e quebra com "Unable to resolve host". Em dev local
# (emulador/celular na mesma rede), pode ser algo como 192.168.x.x:9000.
MINIO_PUBLIC_ENDPOINT=
# Em branco = herda MINIO_SECURE. Defina true/false para sobrescrever (ex.:
# domínio público do MinIO atrás de proxy HTTPS).
MINIO_PUBLIC_SECURE=

# Limites de planos (ajuste via variáveis de ambiente no Coolify, sem redeploy)
FREE_MAX_GROWS=1
FREE_MAX_POTS_PER_GROW=3
FREE_MAX_PLANTS=1
FREE_AI_QUERIES_PER_MONTH=1
JARDINEIRO_MAX_GROWS=1
JARDINEIRO_MAX_POTS_PER_GROW=3
JARDINEIRO_MAX_PLANTS=2
JARDINEIRO_AI_QUERIES_PER_MONTH=4
CULTIVADOR_MAX_GROWS=2
CULTIVADOR_MAX_POTS_PER_GROW=10
CULTIVADOR_MAX_PLANTS=8

# Resend (e-mail transacional — cadastre em https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@letsgrow.app
